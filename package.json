    "probe:calldata": "node tools/probe-calldata.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.29.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "6.0.0"
  },
  "overrides": {
    "viem": "2.29.0"
  }
}
